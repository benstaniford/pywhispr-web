#!/bin/bash

# Comprehensive Test Suite for pywhispr-web
# Runs all tests: Python unit tests + Docker container tests

# Note: We handle errors manually instead of using set -e
# so that test failures don't stop the entire test suite

echo "🧪 pywhispr-web Test Suite"
echo "========================================"
echo ""

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
NC='\033[0m' # No Color

# Test configuration
START_TIME=$(date +%s)
PYTHON_TESTS_PASSED=0
JS_TESTS_PASSED=0
DOCKER_TESTS_PASSED=0
TOTAL_ERRORS=0

# Function to print section headers
print_section() {
    echo -e "${CYAN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    echo -e "${CYAN}  $1${NC}"
    echo -e "${CYAN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    echo ""
}

# Function to handle test results
handle_test_result() {
    local test_name="$1"
    local exit_code="$2"
    
    if [ $exit_code -eq 0 ]; then
        echo -e "${GREEN}✅ $test_name passed${NC}"
    else
        echo -e "${RED}❌ $test_name failed (exit code: $exit_code)${NC}"
        ((TOTAL_ERRORS++))
    fi
    # Always return 0 to prevent script exit with set -e
    return 0
}

# Cleanup function for Docker tests
cleanup_docker() {
    echo -e "${YELLOW}🧹 Cleaning up Docker environment...${NC}"
    docker compose down --remove-orphans 2>/dev/null || true
    rm -f cookies.txt test-response.html api-response.json app-response.html \
          put-response.json reread-response.json ready-response.json 2>/dev/null || true
}

# Set cleanup trap
trap cleanup_docker EXIT

print_section "PHASE 1: PYTHON UNIT TESTS"

# Test 1: Import Tests
echo -e "${BLUE}🔍 Test 1.1: Running import tests...${NC}"
if python tests/test_imports.py; then
    handle_test_result "Import tests" 0
    ((PYTHON_TESTS_PASSED++))
else
    handle_test_result "Import tests" 1
    echo -e "${YELLOW}ℹ️  Note: Some import failures may be expected outside Docker environment${NC}"
fi
echo ""

# Test 2: Unit Tests
echo -e "${BLUE}🔧 Test 1.2: Running unit tests...${NC}"
# Check if pytest is available, fallback to unittest
if command -v pytest >/dev/null 2>&1; then
    if python -m pytest tests/test_simple.py -v 2>/dev/null; then
        handle_test_result "Unit tests (pytest)" 0
        ((PYTHON_TESTS_PASSED++))
    else
        # Try with unittest as fallback
        echo -e "${YELLOW}⚠️  pytest failed, trying unittest...${NC}"
        python -m unittest discover tests/ -v
        unittest_exit_code=$?
        if [ $unittest_exit_code -eq 0 ]; then
            handle_test_result "Unit tests (unittest)" 0
            ((PYTHON_TESTS_PASSED++))
        else
            handle_test_result "Unit tests" $unittest_exit_code
            echo -e "${YELLOW}ℹ️  Note: Unit test failures may be due to missing dependencies outside Docker${NC}"
        fi
    fi
else
    # Use unittest directly
    python -m unittest discover tests/ -v
    unittest_exit_code=$?
    if [ $unittest_exit_code -eq 0 ]; then
        handle_test_result "Unit tests (unittest)" 0
        ((PYTHON_TESTS_PASSED++))
    else
        handle_test_result "Unit tests" $unittest_exit_code
        echo -e "${YELLOW}ℹ️  Note: Unit test failures may be due to missing dependencies outside Docker${NC}"
    fi
fi
echo ""

print_section "PHASE 2: DOCKER CONTAINER TESTS"

# Test 3: Docker Container Test Suite
echo -e "${BLUE}🐳 Test 2.1: Running comprehensive Docker container tests...${NC}"
echo -e "${YELLOW}ℹ️  This may take several minutes for the first build...${NC}"
echo ""

# Run the Docker test script
# Ensure we have the correct path to the test script
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$(dirname "$SCRIPT_DIR")"
DOCKER_TEST_SCRIPT="$PROJECT_ROOT/test-docker/test-container.sh"
echo "Running $DOCKER_TEST_SCRIPT"

if [ ! -f "$DOCKER_TEST_SCRIPT" ]; then
    echo -e "${RED}❌ Docker test script not found at: $DOCKER_TEST_SCRIPT${NC}"
    handle_test_result "Docker container test suite" 1
else
    "$DOCKER_TEST_SCRIPT"
    docker_exit_code=$?
    if [ $docker_exit_code -eq 0 ]; then
        handle_test_result "Docker container test suite" 0
        ((DOCKER_TESTS_PASSED++))
    else
        handle_test_result "Docker container test suite" $docker_exit_code
    fi
fi
echo ""

print_section "TEST RESULTS SUMMARY"

# Calculate test statistics
END_TIME=$(date +%s)
DURATION=$((END_TIME - START_TIME))
TOTAL_TESTS=$((PYTHON_TESTS_PASSED + DOCKER_TESTS_PASSED))

echo -e "${BLUE}📊 Test Statistics:${NC}"
echo -e "   Duration: ${DURATION} seconds"
echo -e "   Python Tests: ${PYTHON_TESTS_PASSED}/2 passed"
echo -e "   Docker Tests: ${DOCKER_TESTS_PASSED}/1 passed"
echo -e "   Total Errors: ${TOTAL_ERRORS}"
echo ""

if [ $TOTAL_ERRORS -eq 0 ]; then
    echo -e "${GREEN}🎉 ALL TESTS PASSED! 🎉${NC}"
    echo ""
    echo -e "${GREEN}✨ pywhispr-web is ready for production! ✨${NC}"
    echo ""
    echo -e "${BLUE}📋 What was tested:${NC}"
    echo -e "   • Python import functionality"
    echo -e "   • Python unit test coverage"
    echo -e "   • Docker build process"
    echo -e "   • Container health and startup"
    echo -e "   • Web interface functionality"
    echo -e "   • API endpoint validation"
    echo -e "   • Performance benchmarks"
    echo ""
    echo -e "${BLUE}🚀 Next steps:${NC}"
    echo -e "   • Deploy with: docker compose up -d"
    echo -e "   • Access at: http://localhost:5000"
    echo ""
    exit 0
else
    echo -e "${RED}❌ Some tests failed (${TOTAL_ERRORS} errors)${NC}"
    echo ""
    echo -e "${YELLOW}🔧 Troubleshooting tips:${NC}"
    
    if [ $PYTHON_TESTS_PASSED -lt 2 ]; then
        echo -e "   • Python test failures are often due to missing dependencies"
        echo -e "   • Install dependencies: pip install -r requirements.txt"
        echo -e "   • Some failures may be expected outside Docker environment"
    fi
    
    if [ $DOCKER_TESTS_PASSED -lt 1 ]; then
        echo -e "   • Docker test failures may indicate container issues"
        echo -e "   • Check Docker is running: docker --version"
        echo -e "   • Check port 5000 is available: lsof -i :5000"
        echo -e "   • Review logs: docker compose logs pywhispr-web"
    fi
    
    echo ""
    echo -e "${BLUE}📋 For detailed logs, check:${NC}"
    echo -e "   • Python tests: Run individually in tests/ directory"
    echo -e "   • Docker tests: ./test-docker/test-container.sh"
    echo ""
    exit 1
fi
